generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  name             String
  phone            String?
  role             UserRole           @default(HOD)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  AdmissionHistory AdmissionHistory[]
  auditLogs        AuditLog[]
  Refund           Refund[]
}

model Student {
  id              String            @id @default(uuid())
  email           String?            @unique
  name            String
  phone           String?
  dob             DateTime?
  address         String?
  photoUrl        String?
  status          StudentStatus     @default(ACTIVE)
  courseId        String
  sessionId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  class_roll      String?
  isDeleted       Boolean           @default(false)
  reg_no          String?           @unique
  uan_no          String?           @unique
  category        Category?
  fatherName      String?
  gender          Gender?
  university_roll String?           @unique
  admissions      Admission[]
  payments        Payment[]
  course          Course            @relation(fields: [courseId], references: [id])
  session         Session           @relation(fields: [sessionId], references: [id])
  documents       StudentDocument[]
  semesters       StudentSemester[]
  StudentSubject  StudentSubject[]
}

model StudentDocument {
  id                String  @id @default(uuid())
  studentId         String
  type              String
  fileUrl           String
  verified          Boolean @default(false)
  verificationNotes String?
  student           Student @relation(fields: [studentId], references: [id])
}

model Department {
  id              String            @id @default(uuid())
  name            String
  code            String?           @unique
  description     String?
  admission       Admission[]
  admissionWindow AdmissionWindow[]
  courses         Course[]
}

model Course {
  id              String            @id @default(uuid())
  code            String
  name            String
  durationYears   Int
  departmentId    String
  admissions      Admission[]
  admissionWindow AdmissionWindow[]
  department      Department        @relation(fields: [departmentId], references: [id])
  sessions        CourseSession[]
  feeStructure    FeeStructure[]
  semesters       Semester[]
  students        Student[]
  subjects        Subject[]
}

model Subject {
  id             String           @id @default(uuid())
  code           String
  name           String
  semesterId     String
  courseId       String
  type           SubjectType
  StudentSubject StudentSubject[]
  course         Course           @relation(fields: [courseId], references: [id])
  semester       Semester         @relation(fields: [semesterId], references: [id])

  @@unique([code, courseId, semesterId])
}

model StudentSubject {
  id         String   @id @default(uuid())
  studentId  String
  subjectId  String
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, semesterId])
}

model Session {
  id         String          @id @default(uuid())
  name       String
  startYear  Int
  endYear    Int
  admissions Admission[]
  courses    CourseSession[]
  students   Student[]
}

model Semester {
  id               String            @id @default(uuid())
  number           Int
  courseId         String
  admissions       Admission[]
  feeStructure     FeeStructure[]
  course           Course            @relation(fields: [courseId], references: [id])
  studentSemesters StudentSemester[]
  StudentSubject   StudentSubject[]
  subjects         Subject[]

  @@unique([number, courseId])
}

model CourseSession {
  id        String  @id @default(uuid())
  courseId  String
  sessionId String
  course    Course  @relation(fields: [courseId], references: [id])
  session   Session @relation(fields: [sessionId], references: [id])

  @@unique([courseId, sessionId])
}

model StudentSemester {
  id         String         @id @default(uuid())
  studentId  String
  semesterId String
  feePaid    Boolean        @default(false)
  startDate  DateTime
  endDate    DateTime?
  status     SemesterStatus
  semester   Semester       @relation(fields: [semesterId], references: [id])
  student    Student        @relation(fields: [studentId], references: [id])

  @@unique([studentId, semesterId])
}

model AdmissionWindow {
  id           String     @id @default(uuid())
  courseId     String
  departmentId String
  startDate    DateTime
  endDate      DateTime
  enabled      Boolean    @default(false)
  title        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  course       Course     @relation(fields: [courseId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
}

model Admission {
  id             String             @id @default(uuid())
  courseId       String
  departmentId   String?
  status         AdmissionStatus    @default(INITIATED)
  studentId      String
  admissionNo    String?
  confidentialNo String?
  meritListType  String?
  profileNo      String?
  academicYear   String
  semesterId     String
  sessionId      String
  type           AdmissionType
  createdAt      DateTime           @default(now())
  course         Course             @relation(fields: [courseId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id])
  semester       Semester           @relation(fields: [semesterId], references: [id])
  session        Session            @relation(fields: [sessionId], references: [id])
  student        Student            @relation(fields: [studentId], references: [id])
  history        AdmissionHistory[]
  payments       Payment[]

  @@unique([studentId, semesterId, academicYear])
  @@index([studentId])
  @@index([courseId])
  @@index([sessionId])
  @@index([semesterId])
  @@index([type, academicYear])
}

model AdmissionHistory {
  id          String          @id @default(uuid())
  admissionId String
  fromStatus  AdmissionStatus
  toStatus    AdmissionStatus
  changedById String
  changedAt   DateTime        @default(now())
  notes       String?
  admission   Admission       @relation(fields: [admissionId], references: [id])
  changedBy   User            @relation(fields: [changedById], references: [id])
}

model Payment {
  id               String              @id @default(uuid())
  studentId        String?
  admissionId      String?
  status           PaymentStatus
  gateway          String
  txnId            String              @unique
  receiptUrl       String?
  createdAt        DateTime            @default(now())
  receiptNo        String              @unique
  referenceNo      String?
  totalAmount      Decimal
  bankTxnNo        String?
  gatewayPaymentId String?
  certificateId    String?             @unique
  admission        Admission?          @relation(fields: [admissionId], references: [id])
  certificate      CertificateRequest? @relation(fields: [certificateId], references: [id])
  student          Student?            @relation(fields: [studentId], references: [id])
  breakups         PaymentBreakup[]
  receipt          Receipt[]
  refund           Refund?
}

model PaymentBreakup {
  id        String  @id @default(uuid())
  paymentId String
  head      FeeHead
  amount    Decimal
  payment   Payment @relation(fields: [paymentId], references: [id])

  @@index([head])
}

model FeeStructure {
  id         String   @id @default(uuid())
  courseId   String
  semesterId String
  head       FeeHead
  amount     Decimal
  course     Course   @relation(fields: [courseId], references: [id])
  semester   Semester @relation(fields: [semesterId], references: [id])

  @@unique([courseId, semesterId, head])
}

model Receipt {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  pdfUrl    String
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model Refund {
  id           String   @id @default(uuid())
  paymentId    String   @unique
  amount       Decimal
  reason       String
  refundedById String
  refundedAt   DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id])
  refundedBy   User     @relation(fields: [refundedById], references: [id])
}

model CertificateRequest {
  id             String            @id @default(uuid())
  type           CertificateType
  purpose        String?
  status         CertificateStatus @default(PENDING)
  issuedAt       DateTime?
  pdfUrl         String?
  appliedAt      DateTime          @default(now())
  certificateNo  String?           @unique
  characterCertificateNo String? @unique
  character      String?
  collegeRoll    String?
  courseName     String
  createdAt      DateTime          @default(now())
  departmentName String
  dob            DateTime?
  examMonth      String?
  examYear       String?
  fatherName     String
  motherName     String?
  name           String
  registrationNo String?
  remarks        String?
  resultDivision String?
  semester       String
  session        String
  universityRoll String?
  updatedAt      DateTime          @updatedAt
  payment        Payment?
}

model Gallery {
  id        String   @id @default(uuid())
  title     String
  coverUrl  String?
  createdAt DateTime @default(now())
}

model News {
  id          String  @id @default(uuid())
  title       String
  body        String
  isPublished Boolean @default(false)
  url         String?
}

model Notice {
  id    String  @id @default(uuid())
  title String
  body  String
  url   String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  payload   Json?
  ipAddress String?
  timestamp DateTime @default(now())
  userAgent String?
  user      User     @relation(fields: [userId], references: [id])
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  HOD
  ACCOUNTANT
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  PENDING
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  PASSED_OUT
  ALUMNI
  DROPOUT
}

enum CertificateType {
  BONAFIDE
  CLC
  CHARACTER
  CLC_CHARACTER
}

enum CertificateStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
}

enum FeeHead {
  TUITION
  EXAM
  INFRASTRUCTURE
  DEVELOPMENT
  CERTIFICATE
  MISC
  PRACTICAL
}

enum AdmissionStatus {
  INITIATED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
}

enum SemesterStatus {
  ONGOING
  COMPLETED
  FAILED
  PROMOTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  BC_I
  BC_II
  SC
  ST
  EWS
}

enum SubjectType {
  MJC
  MIC
  MDC
  SEC
  VAC
}

enum AdmissionType {
  NEW
  CONTINUATION
}
