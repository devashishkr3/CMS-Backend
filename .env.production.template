# GetEpay Payment Gateway - Production Environment Variables
# Copy these variables to your .env file in production
# IMPORTANT: Replace <PLACEHOLDERS> with actual values from GetEpay

# ============================================
# PRODUCTION CONFIGURATION
# ============================================

# Node Environment
NODE_ENV=production

# GetEpay Merchant ID (Provided by GetEpay)
GETEPAY_MID=1379045

# GetEpay Terminal ID (Provided by GetEpay)
GETEPAY_TERMINAL_ID=getepay.merchant989958@vvsbbank

# GetEpay Encryption Key (Provided by GetEpay - Base64 encoded)
# ⚠️ REPLACE WITH YOUR ACTUAL PRODUCTION KEY
GETEPAY_KEY=<YOUR_PRODUCTION_ENCRYPTION_KEY_HERE>

# GetEpay Initialization Vector
# Option 1: Use Terminal ID as IV (auto-detected by system)
GETEPAY_IV=getepay.merchant989958@vvsbbank

# Option 2: Use Base64 IV if provided by GetEpay (uncomment if applicable)
# GETEPAY_IV=<BASE64_IV_FROM_GETEPAY>

# GetEpay API Endpoint URL - CRITICAL: Must include port :8443
GETEPAY_URL=https://portal.getepay.in:8443/getepayPortal/pg/v2/generateInvoice

# Return URL (where users are redirected after payment)
GETEPAY_RETURN_URL=https://api.santsandhyadasmahilacollege.org/api/v1/payments/return

# Callback URL (where gateway sends payment status updates)
GETEPAY_CALLBACK_URL=https://api.santsandhyadasmahilacollege.org/api/v1/payments/callback

# ============================================
# ADDITIONAL PRODUCTION SETTINGS
# ============================================

# Server Port
PORT=8080

# JWT Secrets (Use strong, unique keys in production)
JWT_ACCESS_SECRET=<STRONG_RANDOM_SECRET_KEY_FOR_PRODUCTION>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<ANOTHER_STRONG_RANDOM_SECRET_KEY>
JWT_REFRESH_EXPIRES_IN=14d

# Database Connection
DATABASE_URL=<YOUR_PRODUCTION_DATABASE_URL>

# Cloudflare R2 Storage (if using file uploads)
R2_ACCOUNT_ID="<YOUR_R2_ACCOUNT_ID>"
R2_ACCESS_KEY_ID="<YOUR_R2_ACCESS_KEY>"
R2_SECRET_ACCESS_KEY="<YOUR_R2_SECRET_KEY>"
R2_BUCKET_NAME="<YOUR_R2_BUCKET_NAME>"
R2_ENDPOINT="<YOUR_R2_ENDPOINT>"

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_EMAIL>
SMTP_PASS=<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>

# ============================================
# VERIFICATION CHECKLIST
# ============================================
# Before deploying, verify:
# ✅ GETEPAY_URL includes :8443 port
# ✅ GETEPAY_URL uses /pg/v2/generateInvoice path
# ✅ GETEPAY_KEY is your actual production key (not placeholder)
# ✅ GETEPAY_IV is set (either Terminal ID or Base64 IV)
# ✅ GETEPAY_RETURN_URL points to production domain
# ✅ GETEPAY_CALLBACK_URL points to production domain
# ✅ All secrets are strong and unique
# ✅ Database URL is correct for production
