      "headers": {
        "Authorization": "Bearer <token>"
      }
    },
    "getSessions": {
      "endpoint": "GET /api/v1/sessions",
      "headers": {
        "Authorization": "Bearer <token>"
      },
      "queryParameters": {
        "courseId": "Optional - Filter by course ID",
        "search": "Optional - Search by session name"
      }
    },
